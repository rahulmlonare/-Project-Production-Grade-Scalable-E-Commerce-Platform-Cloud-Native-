Step 4 Create Add-To-Cart API

Below your /orders API add:

app.post("/cart", async (req, res) => {

    try{

        const {

            productId,
            productName,
            price

        } = req.body;

        const cartItem = {

            cartId: uuidv4(),

            productId,

            productName,

            price

        };

        await dynamoDB.send(

            new PutCommand({

                TableName:"shopping-cart",

                Item:cartItem

            })

        );

        res.json({

            message:"Product added to cart",

            cartItem

        });

    }

    catch(err){

        console.log(err);

        res.status(500).send("Error");

    }

});
