***** Step 8 Create Logout

Replace your entire src/components/Navbar.jsx with the following:

rc/components/ $ Navbar.jsx

import { Link } from "react-router-dom";

function Navbar() {

  const logout = () => {
    localStorage.removeItem("token");
    window.location.href = "/login";
  };

  const token = localStorage.getItem("token");

  return (
    <nav
      style={{
        padding: "15px",
        background: "#282c34",
        display: "flex",
        justifyContent: "space-between",
        alignItems: "center"
      }}
    >
      <div>
        <Link
          to="/"
          style={{ color: "white", marginRight: "20px", textDecoration: "none" }}
        >
          Home
        </Link>

        <Link
          to="/cart"
          style={{ color: "white", marginRight: "20px", textDecoration: "none" }}
        >
          Cart
        </Link>

        <Link
          to="/orders"
          style={{ color: "white", marginRight: "20px", textDecoration: "none" }}
        >
          Orders
        </Link>
      </div>

      <div>
        {token ? (
          <button
            onClick={logout}
            style={{
              padding: "8px 16px",
              cursor: "pointer"
            }}
          >
            Logout
          </button>
        ) : (
          <Link
            to="/login"
            style={{ color: "white", textDecoration: "none" }}
          >
            Login
          </Link>
        )}
      </div>
    </nav>
  );
}

export default Navbar;

