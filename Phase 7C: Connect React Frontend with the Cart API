Step 1 – Update frontend/src/components/ ProductCard.jsx

Replace your current ProductCard.jsx with:

import api from "../api/api";

function ProductCard({ product }) {

    const addToCart = async () => {

        try {

            await api.post("/cart", {

                productId: product.id,

                productName: product.name,

                price: product.price

            });

            alert("Product Added To Cart");

        } catch (err) {

            console.error(err);

            alert("Error adding product");

        }

    };

    return (

        <div
            style={{
                border: "1px solid gray",
                padding: "20px",
                margin: "20px",
                width: "250px"
            }}
        >

            <h2>{product.name}</h2>

            <h3>₹ {product.price}</h3>

            <button onClick={addToCart}>
                Add To Cart
            </button>

        </div>

    );

}

export default ProductCard;


Step 2 – Create Cart Page

Replace /Ecommerce-app/frontend/src/pages/ Cart.jsx 
with:

import { useEffect, useState } from "react";
import api from "../api/api";

function Cart() {

    const [cart, setCart] = useState([]);

    useEffect(() => {

        loadCart();

    }, []);

    async function loadCart() {

        try {

            const res = await api.get("/cart");

            setCart(res.data);

        } catch (err) {

            console.log(err);

        }

    }

    return (

        <div>

            <h1>Shopping Cart</h1>

            {

                cart.map(item => (

                    <div
                        key={item.cartId}
                        style={{
                            border: "1px solid gray",
                            margin: "10px",
                            padding: "15px"
                        }}
                    >

                        <h2>{item.productName}</h2>

                        <h3>₹ {item.price}</h3>

                    </div>

                ))

            }

        </div>

    );

}

export default Cart;


