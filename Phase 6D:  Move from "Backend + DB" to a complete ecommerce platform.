Backend inserts into PostgreSQL.

This demonstrates CRUD operations, which interviewers almost always ask about.

Your server.js should look like this:

/* orders */
app.get("/orders", async (req, res) => {
  try {
    const result = await pool.query(
      "SELECT * FROM orders ORDER BY id"
    );

    res.json(result.rows);
  } catch (err) {
    console.error(err);
    res.status(500).send("Server Error");
  }
});

/* create order */
app.post("/orders", async (req, res) => {
  try {
    const { product_id, quantity, customer_name } = req.body;

    const result = await pool.query(
      `INSERT INTO orders (product_id, quantity, customer_name)
       VALUES ($1, $2, $3)
       RETURNING *`,
      [product_id, quantity, customer_name]
    );

    res.status(201).json(result.rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).send("Server Error");
  }
});

const PORT = 5000;

app.listen(PORT, () => {
  console.log(`Backend running on ${PORT}`);
});


